{
  "name": "terra-pavlodar",
  "version": "0.2.0",
  "private": true,
  "description": "Satellite imagery comparison for Pavlodar, Kazakhstan",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts package.json tsconfig.json .github"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
